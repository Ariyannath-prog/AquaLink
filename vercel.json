{
  "buildCommand": "python3 -m pip install --disable-pip-version-check --no-cache-dir --user gdown==5.2.0 && python3 scripts/download_models.py",
  "outputDirectory": ".",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/models/(.*\\.glb)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Content-Type",
          "value": "model/gltf-binary"
        }
      ]
    }
  ]
}